<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="true">

    <!-- Top Dashboard Header -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand_emerald_dark"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Pantry 🌿"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Track your ingredients &amp; reduce waste"
            android:textColor="#A7F3D0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main List Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pantry_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:layout_above="@id/bottom_navigation"
        android:clipToPadding="false"
        android:paddingVertical="12dp" />

    <!-- Add Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_ingredient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:contentDescription="Add Ingredient"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/brand_emerald"
        app:tint="#FFFFFF"
        app:elevation="6dp" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        app:elevation="8dp"
        app:itemIconTint="@color/brand_emerald_dark"
        app:itemTextColor="@color/brand_emerald_dark"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>